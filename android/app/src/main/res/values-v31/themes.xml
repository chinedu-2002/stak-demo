<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws a system splash before the first frame; it cannot be turned off,
         only coloured. It is the frame's ground (1:926 Bg) with NO icon, so the only launch screen
         anyone sees is the authored 00 Splash that follows (user, 2026-09-05: "this should be
         whenever a user opens STAK" - the earlier centred launcher mark was not in the design).
         iOS does the same: LaunchBackground, no image, then SplashView. -->
    <style name="Theme.STAK" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A1020</item>
        <item name="android:statusBarColor">#0A1020</item>
        <item name="android:navigationBarColor">#10172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#0A1020</item>
        <!-- The 00 Splash frame's logo mark at its authored size and height (splash_system_mark):
             the one part of 1:926 the system splash can carry, so the launch reads as the frame
             from its first pixel; the ball and type follow in the app's own first frame
             (user, 2026-09-05: "if it is mandatory then replace it with 1:926"). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_system_mark</item>
    </style>
</resources>
